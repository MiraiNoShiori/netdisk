# 复制成 .env 后按需修改
# cp .env.example .env

# HTTP 监听地址（默认 8081）
NETDISK_ADDR=:8081

# PostgreSQL（与 docker-compose.yml 里的端口对应）
NETDISK_DATABASE_URL=postgres://netdisk:netdisk@localhost:5433/netdisk?sslmode=disable

# JWT 签名密钥。生产环境必须换成长随机串：
#   openssl rand -hex 32
NETDISK_JWT_SECRET=dev-only-change-me
# access token 与 refresh token 有效期
NETDISK_JWT_TTL=24h
NETDISK_REFRESH_TTL=168h

# 是否允许公开注册；已有账号仍可登录。
ALLOW_REGISTER=true
# 允许仅凭哈希和大小跨账号秒传。默认仅复用本人存活文件引用的内容。
ALLOW_GLOBAL_INSTANT_UPLOAD=false
# 下载 Cookie 的 Secure 属性：auto / true / false。全站 HTTPS 可设为 true。
COOKIE_SECURE=auto
# auto 默认只认直连 TLS。若代理会覆盖 X-Forwarded-Proto，可填写其 TCP 源地址网段。
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 新注册用户默认存储配额（字节；默认 10 GiB，设为 0 表示不限制）
NETDISK_DEFAULT_QUOTA_BYTES=10737418240

# 回收站自动清理保留时长（默认 30 天 = 720h）
NETDISK_TRASH_RETENTION=720h

# 可选跨域白名单（逗号分隔，如 http://localhost:3000,https://disk.example.com；留空则仅同源）
# NETDISK_CORS_ORIGINS=http://localhost:3000

# 存储后端：local | s3
NETDISK_STORAGE_DRIVER=local
# local 后端的落盘目录
NETDISK_STORAGE_DIR=./data/blobs

# 热点文件自动分层至 S3（默认 0 关闭；设为如 10 表示下载满 10 次且不小于 MIN_SIZE 的本地文件自动迁至 S3）
# NETDISK_AUTO_TIER_THRESHOLD=10
# NETDISK_AUTO_TIER_MIN_SIZE=1048576

# --- s3 后端（可选）---
# NETDISK_S3_ENDPOINT=localhost:9000
# NETDISK_S3_ACCESS_KEY=minioadmin
# NETDISK_S3_SECRET_KEY=minioadmin
# NETDISK_S3_BUCKET=netdisk
# NETDISK_S3_USE_SSL=false
# NETDISK_S3_REGION=us-east-1
# 签名直链的客户端可访问域名（不能带 http:// 前缀，TLS 与 USE_SSL 一致）
# NETDISK_S3_PUBLIC_ENDPOINT=192.168.1.10:9000

# NFSv3 可选；先通过网页注册用户，再填用户名并重启服务。
# 一实例只导出一个用户。默认禁用；启用后默认只允许本机访问。
# NETDISK_NFS_ADDR=127.0.0.1:2049
# NETDISK_NFS_USER=demo
# NETDISK_NFS_CLIENTS=127.0.0.1/32,::1/128
